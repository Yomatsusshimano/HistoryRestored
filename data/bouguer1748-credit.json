  "passages": [
    {
      "locator": "p11/canvas163",
      "finding": "Article heading names Bouguer and heliometer; historical24April1748label. Claims existing micrometers lose precision for larger arcs, motivating proposed new instrument. No measured error bound established here."
    },
    {
      "locator": "pp12-13/canvases164-165",
      "finding": "Credits Kepler optical principle with Dioptrice1611propositionLXXXVI citation, and Huygens SystemaSaturnium1659 focal-plane visibility. Says Auzout/Picard gave instrument final form; later assigns entire mechanism/disposition and consequently whole micrometer to them. No Gascoigne name in these selected paragraphs; knowledge/intent unverified."
    },
    {
      "locator": "p13footnote/canvas165",
      "finding": "Cites Manière exacte pour prendre les diamètres des Planètes, Paris JeanCusson1666. Treatise contents, exact authorship and correspondence relation uninspected; citation label is not proof of publication or execution date."
    },
    {
      "locator": "pp13-14/canvases165-166",
      "finding": "Describes screw-driven frame with wires/silk at focal plane and notes fixed terrestrial versus moving celestial use differences, magnification/field limitations and alternating-limb tracking. Description is not observed performance or surviving-object authentication."
    },
    {
      "locator": "pp15-18/canvases167-170",
      "finding": "Discusses limb comparison and timing limitations. Averaging under assumed sphericity could conceal axis differences. Historical claims about Jupiter and earlier observations require original-source checks; no validated shape inference."
    },
    {
      "locator": "pp18-22/canvases170-174",
      "finding": "Proposes parallel wires and even-number pendulum beats to reduce unequal alternating beats. Criticizes Louville1724 and later partial adoption of the method. p22 converts 2min22sec of true solar time to35arcmin30arcsec using360degrees/24hours; this is hour-angle conversion, not a disk diameter without declination. Cited Louville text and later books remain uninspected."
    },
    {
      "locator": "pp23-26/canvases175-178",
      "finding": "Proposes two objectives with one eyepiece and upper/lower micrometer readings. Terrestrial target calibration is required; screw displacement divided by focal length alone is inadequate across the whole travel. Claimed precision and longer-telescope possibilities are proposals, not inspected trials."
    },
    {
      "locator": "pp27-29/canvases179-181",
      "finding": "Reports commissioning eight nominal18feet focal-length objectives from an unnamed skilled artisan, selecting two after examination; two or three differed7-8inches in focal length. Describes contrast, irradiation, shading and thermal-expansion concerns. This is a contemporary construction report, not surviving-object or workshop authentication. Historical solar observation methods are not modern safety instructions."
    },
    {
      "locator": "pp30-31/canvases182-183",
      "finding": "Reports beginning observations last October, without an authenticated absolute start date here. Apparent vertical solar diameter reportedly exceeds horizontal by0.5-1arcsec despite expected refraction shortening; tentative true excess2.5-3arcsec and at least1/750 axis difference are author inferences. He suspends judgment pending different instruments and seasonal/altitude comparisons."
    },
    {
      "locator": "pp32-34/canvases184-186",
      "finding": "Considers atmospheric dispersion and colored solar limbs; cites Delisle1715p168 without original inspection here. p34 expressly says the apparent vertical excess does not prove a genuinely larger solar axis. Longer use is required to separate dispersion expansion from ordinary refraction compression. No dated per-trial raw observation table or validated accuracy established."
    }
  ],
  "bevis_comparison": "Supports identification of actual broad Auzout/Picard apparatus credit, stronger than merely perfectedconstruction wording in deLaHire1717. Earlier Kepler/Huygens principles are also credited. Does not establish complete priority, opponent access to Gascoigne work, deliberate appropriation, ancient recovery or measured accuracy.",
  "dependence": "Bouguer cites earlier optical/treatise works. Actual author/edition transmission relationship to deLaHire or Bevis not authenticated; shared historical credit is not independent instrument measurement. Manifest/catalog and image share BSB surrogate lineage.",
  "limits": [
    "Other volume plates uninspected; no instrument illustration assigned",
    "Cited Kepler/Huygens/1666treatise/Louville1724/Delisle1715 originals not inspected",
    "Unnamed artisan; no surviving instrument, workshop or calibration records authenticated",
    "Relative last October observation start not promoted to an exact date",
    "No Gascoigne knowledge or intent chain",
    "No validated solar shape or accuracy result",
    "No independent review"
  ],
